# Required: exact local application origin (scheme, host, port; no path).
APP_ORIGIN=
# Required: local Supabase API URL; only loopback addresses are accepted in M1.
SUPABASE_URL=
# Required: Supabase publishable/anon key, NEVER a service-role or secret key.
SUPABASE_PUBLISHABLE_KEY=
# Generate local values with pnpm local:setup after starting local Supabase.
# Do not put passwords, service-role keys, or database credentials in this file.
# Optional offline test/development override (server-only; no paid provider calls):
# JARVIS_MOCK_ONLY=1
# Voice needs no browser/public key. On the NEW machine, after migrations:
# pnpm live:configure openai       (existing hidden project-key setup)
# pnpm live:configure transcription (enables server audio only; no API call)
# Then separately enable Cloud transcription in Assistant after reading consent.
# Credentials stay in ignored .local/live.json (0600), never NEXT_PUBLIC variables.

# Privacy Center needs no new public/admin environment variable.
# On the NEW machine after all migrations: pnpm worker enforces cleanup/retention.
# pnpm privacy:finalizer is an isolated local operator process for confirmed erasures.
# It uses existing guarded local status; never add service-role credentials to web config.
# Key configuration and per-user text/audio/notification consent are distinct.
