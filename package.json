{
  "name": "jarvis-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:start": "node scripts/local.mjs start",
    "db:reset": "node scripts/local.mjs reset",
    "db:migrate": "node scripts/local.mjs migrate",
    "db:reconstruct": "node scripts/reconstruct.mjs",
    "db:stop": "node scripts/local.mjs stop",
    "local:setup": "node scripts/local.mjs setup",
    "local:users": "node scripts/local.mjs users",
    "local:diagnose": "node scripts/local.mjs diagnose",
    "local:audit": "node scripts/audit.mjs",
    "db:types": "node scripts/local.mjs types",
    "test:https": "node scripts/https-check.mjs",
    "worker:setup": "node scripts/worker-setup.mjs",
    "worker": "node scripts/worker.mjs",
    "privacy:finalizer": "node scripts/privacy-finalizer.mjs",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "live:configure": "node scripts/live-configure.mjs",
    "live:status": "node scripts/live-configure.mjs status",
    "live:pushover-test": "node scripts/pushover-test.mjs",
    "live:admit": "node scripts/live-admit.mjs",
    "live:evaluate": "node scripts/live-evaluate.mjs",
    "bridge:build": "node scripts/build-bridge.mjs",
    "bridge:check": "node scripts/bridge-chrome-check.mjs",
    "companion:test": "node scripts/companion-swift.mjs test",
    "companion:e2e": "node scripts/companion-e2e.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "openai": "7.45.1",
    "pg-boss": "12.38.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
